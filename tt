# ── Entry point ───────────────────────────────────────────────────────────────

def main():
    args = sys.argv[1:]
    cmd  = args[0] if args else "status"

    dispatch = {
        "status":  lambda: cmd_status(),
        "s":       lambda: cmd_status(),
        "start":   lambda: cmd_start(),
        "stop":    lambda: cmd_stop(),
        "restart": lambda: cmd_restart(),
        "watch":   lambda: cmd_watch(),
        "w":       lambda: cmd_watch(),
        "pom":     lambda: cmd_pom(),
        "bar":     lambda: cmd_bar(),
        "log":     lambda: cmd_log(int(args[1]) if len(args) > 1 else 40),
        "install": lambda: cmd_install(),
        "daemon":  lambda: cmd_daemon(),
        "help":    lambda: print(_HELP),
        "-h":      lambda: print(_HELP),
        "--help":  lambda: print(_HELP),
    }

    fn = dispatch.get(cmd)
    if fn:
        fn()
    else:
        print(red(f"未知命令: {cmd}"))
        print(_HELP)
        sys.exit(1)

if __name__ == "__main__":
    main()
